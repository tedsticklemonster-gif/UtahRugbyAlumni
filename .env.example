# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your-api-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret
# Sender — set once the custom domain is verified in Resend.
# Until then emails fall back to onboarding@resend.dev (test-only delivery).
EMAIL_FROM=moose@mail.your-domain.com
EMAIL_FROM_NAME=Moose (Utah Rugby Alumni)
# Optional: when set, the weekly digest sends ONLY to this address (prod-safe testing)
DIGEST_TEST_RECIPIENT=

# App
NEXT_PUBLIC_APP_URL=https://utah-rugby-alumni.vercel.app

# Cron — shared secret checked by /api/cron/* routes (set the same value in Vercel)
CRON_SECRET=your-random-secret

# Web push (VAPID keys — generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Telegram channel notifications (optional)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
